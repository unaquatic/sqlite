# Trimmed for github.com/unaquatic/sqlite. Upstream's `vendor`, `work` and
# `edit` targets were removed: they drove code generation from sibling
# checkouts (../libsqlite3, ../libsqlite_vec, ../libc, ../libtcl8.6, ../cc,
# ../ccgo, ../libz) and from vendor_libs/, none of which exist in this fork.
#
# Re-transpiling SQLite is therefore not possible here. To move to a newer
# SQLite, re-vendor from upstream modernc.org/sqlite; see README.md.

.PHONY: all build build_all_targets check clean test test_leaks test_race vet

all: check test

build:
	go build ./...

# Compile every package and every test binary for the host.
check:
	go build -v -o /dev/null ./...
	go test -c -o /dev/null .
	$(MAKE) vet

test:
	go test -timeout 1h ./...

# The leak tests skip unless the C allocator counts its allocations.
test_leaks:
	go test -count=1 -tags memory.counters -run Leak .

# The race detector needs cgo.
test_race:
	go test -count=1 -race -timeout 1h .

# Only the hand-written root package. internal/ holds transpiled C,
# which trips vet on self-assignment and unreachable code by construction;
# those reports are upstream artifacts, not defects here.
#
# -unsafeptr=false: the driver reads and writes SQLite's C memory through
# uintptr handles (database, statement and value pointers), so
# uintptr <-> unsafe.Pointer conversions are the design, not a mistake.
# Everything else vet checks stays on.
vet:
	go vet -unsafeptr=false ./

clean:
	rm -f log-* cpu.test mem.test *.out go.work*
	go clean

# Cross-compile the full supported matrix. Self-contained: needs only the Go
# toolchain, since libc is vendored under internal/.
build_all_targets:
	GOOS=darwin GOARCH=amd64 go build -v ./...
	GOOS=darwin GOARCH=arm64 go build -v ./...
	GOOS=freebsd GOARCH=386 go build -v ./...
	GOOS=freebsd GOARCH=amd64 go build -v ./...
	GOOS=freebsd GOARCH=arm go build -v ./...
	GOOS=freebsd GOARCH=arm64 go build -v ./...
	GOOS=linux GOARCH=386 go build -v ./...
	GOOS=linux GOARCH=amd64 go build -v ./...
	GOOS=linux GOARCH=arm go build -v ./...
	GOOS=linux GOARCH=arm64 go build -v ./...
	GOOS=linux GOARCH=loong64 go build -v ./...
	GOOS=linux GOARCH=ppc64le go build -v ./...
	GOOS=linux GOARCH=riscv64 go build -v ./...
	GOOS=linux GOARCH=s390x go build -v ./...
	GOOS=netbsd GOARCH=amd64 go build -v ./...
	GOOS=openbsd GOARCH=amd64 go build -v ./...
	GOOS=openbsd GOARCH=arm64 go build -v ./...
	GOOS=windows GOARCH=386 go build -v ./...
	GOOS=windows GOARCH=amd64 go build -v ./...
	GOOS=windows GOARCH=arm64 go build -v ./...
	echo done
